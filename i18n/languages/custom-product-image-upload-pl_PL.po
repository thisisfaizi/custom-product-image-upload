#. Description of the plugin
msgid ""
"Allows users to upload a specific number of images with cropping for a "
"designated WooCommerce product before adding to cart."
msgstr ""
"Umożliwia użytkownikom przesłanie określonej liczby zdjęć z kadrowaniem dla "
"wyznaczonego produktu WooCommerce przed dodaniem do koszyka."

#. Name of the plugin
msgid "Custom Product Image Upload"
msgstr "Przesyłanie niestandardowego obrazu produktu"

#. Author URI of the plugin
msgid "https://nowdigiverse.com/"
msgstr "https://nowdigiverse.com/"

#. URI of the plugin
msgid "https://nowdigiverse.com/products/"
msgstr "https://nowdigiverse.com/products/"

#. Author of the plugin
msgid "Nowdigiverse"
msgstr "Nowdigiverse"

