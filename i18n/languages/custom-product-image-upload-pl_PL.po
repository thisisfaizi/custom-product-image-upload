#: includes/class-cpiu-admin-interface.php:234
msgid ""
"Configure default settings that will be used as fallback for products "
"without specific configurations."
msgstr ""
"Skonfiguruj ustawienia domyślne, które będą używane jako rezerwowe dla "
"produktów bez określonych konfiguracji."

#: includes/class-cpiu-admin-interface.php:240
msgid "Default Required Images"
msgstr "Domyślne wymagane obrazy"

#: includes/class-cpiu-admin-interface.php:244
msgid "Default number of images required for products."
msgstr "Domyślna liczba obrazów wymaganych dla produktów."

#: includes/class-cpiu-admin-interface.php:249
msgid "Default Max File Size (MB)"
msgstr "Domyślny maksymalny rozmiar pliku (MB)"

#: includes/class-cpiu-admin-interface.php:253
msgid "Default maximum file size in megabytes."
msgstr "Domyślny maksymalny rozmiar pliku w megabajtach."

#: includes/class-cpiu-admin-interface.php:258
msgid "Default Button Text"
msgstr "Domyślny tekst przycisku"

#: includes/class-cpiu-admin-interface.php:262
msgid "Default text for the upload button."
msgstr "Domyślny tekst dla przycisku przesyłania."

#: includes/class-cpiu-admin-interface.php:267
msgid "Default Button Color"
msgstr "Domyślny kolor przycisku"

#: includes/class-cpiu-admin-interface.php:271
msgid "Default color for progress bars and buttons."
msgstr "Domyślny kolor pasków postępu i przycisków."

#: includes/class-cpiu-admin-interface.php:276
msgid "Default Allowed File Types"
msgstr "Domyślne dozwolone typy plików"

#: includes/class-cpiu-admin-interface.php:290
msgid "Default allowed file types for products."
msgstr "Domyślne dozwolone typy plików dla produktów."

#: includes/class-cpiu-admin-interface.php:295
msgid "Resolution Validation"
msgstr "Walidacja rozdzielczości"

#: includes/class-cpiu-admin-interface.php:300
msgid "Enable resolution validation for uploaded images"
msgstr "Włącz walidację rozdzielczości dla przesyłanych obrazów"

#: includes/class-cpiu-admin-interface.php:302
msgid ""
"When enabled, uploaded images must meet minimum and maximum dimension "
"requirements."
msgstr ""
"Po włączeniu tej opcji przesłane obrazy muszą spełniać wymagania dotyczące "
"minimalnych i maksymalnych wymiarów."

#: includes/class-cpiu-admin-interface.php:307
msgid "Minimum Dimensions"
msgstr "Minimalne wymiary"

#: includes/class-cpiu-admin-interface.php:311
msgid "Width:"
msgstr "Szerokość:"

#: includes/class-cpiu-admin-interface.php:316
msgid "Height:"
msgstr "Wysokość:"

#: includes/class-cpiu-admin-interface.php:320
msgid "Minimum required dimensions (0 = no minimum)."
msgstr "Minimalne wymagane wymiary (0 = brak minimum)."

#: includes/class-cpiu-admin-interface.php:325
msgid "Maximum Dimensions"
msgstr "Maksymalne wymiary"

#: includes/class-cpiu-admin-interface.php:338
msgid "Maximum allowed dimensions (0 = no maximum)."
msgstr "Maksymalne dozwolone wymiary (0 = brak maksimum)."

#: includes/class-cpiu-admin-interface.php:343
msgid "Save Default Settings"
msgstr "Zapisz ustawienia domyślne"

#: includes/class-cpiu-admin-interface.php:352
msgid "Add Product Configuration"
msgstr "Dodaj konfigurację produktu"

#: includes/class-cpiu-admin-interface.php:353
msgid "Configure image upload settings for individual products."
msgstr ""
"Skonfiguruj ustawienia przesyłania obrazów dla poszczególnych produktów."

#: includes/class-cpiu-admin-interface.php:359
msgid "Select Product"
msgstr "Wybierz produkt"

#: includes/class-cpiu-admin-interface.php:363
msgid "Search for a product..."
msgstr "Wyszukiwanie produktu..."

#: includes/class-cpiu-admin-interface.php:365
msgid "Start typing to search for products by name or ID."
msgstr ""
"Rozpocznij wpisywanie, aby wyszukać produkty według nazwy lub identyfikatora."

#: includes/class-cpiu-admin-interface.php:370
msgid "Required Images"
msgstr "Wymagane obrazy"

#: includes/class-cpiu-admin-interface.php:374
msgid "Number of images required for this product."
msgstr "Liczba obrazów wymaganych dla tego produktu."

#: includes/class-cpiu-admin-interface.php:379
msgid "Max File Size (MB)"
msgstr "Maksymalny rozmiar pliku (MB)"

#: includes/class-cpiu-admin-interface.php:383
msgid "Maximum file size in megabytes."
msgstr "Maksymalny rozmiar pliku w megabajtach."

#: includes/class-cpiu-admin-interface.php:388
msgid "Button Text"
msgstr "Tekst przycisku"

#: includes/class-cpiu-admin-interface.php:392
msgid "Text for the upload button (leave empty to use default)."
msgstr "Tekst dla przycisku przesyłania (pozostaw pusty, aby użyć domyślnego)."

#: includes/class-cpiu-admin-interface.php:397
msgid "Button Color"
msgstr "Kolor przycisku"

#: includes/class-cpiu-admin-interface.php:401
msgid "Color for progress bars and buttons (leave empty to use default)."
msgstr ""
"Kolor pasków postępu i przycisków (pozostaw pusty, aby użyć domyślnego)."

#: includes/class-cpiu-admin-interface.php:406
msgid "Allowed File Types"
msgstr "Dozwolone typy plików"

#: includes/class-cpiu-admin-interface.php:420
msgid "Allowed file types for this product."
msgstr "Dozwolone typy plików dla tego produktu."

#: includes/class-cpiu-admin-interface.php:483
msgid "Apply the same settings to multiple products at once."
msgstr "Zastosuj te same ustawienia do wielu produktów jednocześnie."

#: includes/class-cpiu-admin-interface.php:489
msgid "Select Products"
msgstr "Wybrane produkty"

#: includes/class-cpiu-admin-interface.php:494
msgid "Select multiple products to apply the same settings."
msgstr "Wybierz wiele produktów, aby zastosować te same ustawienia."

#: includes/class-cpiu-admin-interface.php:597
msgid "Apply to Selected Products"
msgstr "Zastosuj do wybranych produktów"

#: includes/class-cpiu-admin-interface.php:607
msgid "Manage existing product configurations."
msgstr "Zarządzanie istniejącymi konfiguracjami produktów."

#: includes/class-cpiu-admin-interface.php:618
msgid "Import/Export Settings"
msgstr "Ustawienia importu/eksportu"

#: includes/class-cpiu-admin-interface.php:619
msgid "Export your current settings or import previously exported settings."
msgstr ""
"Eksportuj bieżące ustawienia lub importuj wcześniej wyeksportowane "
"ustawienia."

#: includes/class-cpiu-admin-interface.php:624
msgid "Export Settings"
msgstr "Ustawienia eksportu"

#: includes/class-cpiu-admin-interface.php:625
msgid ""
"Download your current plugin settings as a JSON file for backup or migration "
"purposes."
msgstr ""
"Pobierz bieżące ustawienia wtyczki jako plik JSON do celów tworzenia kopii "
"zapasowych lub migracji."

#: includes/class-cpiu-admin-interface.php:637
msgid "Import Settings"
msgstr "Ustawienia importu"

#: includes/class-cpiu-admin-interface.php:638
msgid ""
"Upload a previously exported settings file to restore your configurations."
msgstr ""
"Prześlij wcześniej wyeksportowany plik ustawień, aby przywrócić konfiguracje."

#: includes/class-cpiu-admin-interface.php:654
msgid "Important Notes:"
msgstr "Ważne uwagi:"

#: includes/class-cpiu-admin-interface.php:656
msgid ""
"Export includes all product configurations, default settings, and legacy "
"settings."
msgstr ""
"Eksport obejmuje wszystkie konfiguracje produktu, ustawienia domyślne i "
"starsze ustawienia."

#: includes/class-cpiu-admin-interface.php:657
msgid ""
"Import will overwrite existing settings. Make sure to export current "
"settings first if you want to keep them."
msgstr ""
"Import spowoduje nadpisanie istniejących ustawień. Pamiętaj, aby najpierw "
"wyeksportować bieżące ustawienia, jeśli chcesz je zachować."

#: includes/class-cpiu-admin-interface.php:658
msgid "Uploaded images are not included in the export/import process."
msgstr "Przesłane obrazy nie są uwzględniane w procesie eksportu/importu."

#: includes/class-cpiu-admin-interface.php:659
msgid ""
"Settings exported from one site may not work perfectly on another site due "
"to different product IDs."
msgstr ""
"Ustawienia wyeksportowane z jednej witryny mogą nie działać idealnie w innej "
"witrynie ze względu na różne identyfikatory produktów."

#: includes/class-cpiu-admin-interface.php:664
msgid "Data Protection Notice:"
msgstr "Informacja o ochronie danych:"

#: includes/class-cpiu-admin-interface.php:666
msgid "This plugin follows Envato marketplace standards for data protection:"
msgstr ""
"Ta wtyczka jest zgodna ze standardami Envato Marketplace w zakresie ochrony "
"danych:"

#: includes/class-cpiu-admin-interface.php:669
msgid "Plugin does NOT delete any data when deactivated"
msgstr "Wtyczka NIE usuwa żadnych danych po dezaktywacji"

#: includes/class-cpiu-admin-interface.php:670
msgid "All settings and uploaded images are preserved during deactivation"
msgstr ""
"Wszystkie ustawienia i przesłane obrazy są zachowywane podczas dezaktywacji"

#: includes/class-cpiu-admin-interface.php:671
msgid "Uninstallation requires explicit user confirmation"
msgstr "Odinstalowanie wymaga wyraźnego potwierdzenia przez użytkownika"

#: includes/class-cpiu-admin-interface.php:672
msgid "Users can choose to keep data even during uninstallation"
msgstr "Użytkownicy mogą wybrać zachowanie danych nawet podczas dezinstalacji"

#: includes/class-cpiu-admin-interface.php:673
msgid ""
"Export functionality allows users to backup settings before uninstalling"
msgstr ""
"Funkcja eksportu pozwala użytkownikom na tworzenie kopii zapasowych ustawień "
"przed odinstalowaniem"

#: includes/class-cpiu-admin-interface.php:683
msgid "Monitor all file upload attempts and security events."
msgstr ""
"Monitorowanie wszystkich prób przesyłania plików i zdarzeń bezpieczeństwa."

#: includes/class-cpiu-admin-interface.php:695
msgid "Total Upload Attempts"
msgstr "Łączna liczba prób przesłania"

#: includes/class-cpiu-admin-interface.php:699
msgid "Successful Uploads"
msgstr "Udane przesyłanie"

#: includes/class-cpiu-admin-interface.php:703
msgid "Failed Attempts"
msgstr "Nieudane próby"

#: includes/class-cpiu-admin-interface.php:707
msgid "Unique Users"
msgstr "Unikalni użytkownicy"

#: includes/class-cpiu-admin-interface.php:714
msgid "Clear All Logs"
msgstr "Wyczyść wszystkie dzienniki"

#: includes/class-cpiu-admin-interface.php:718
msgid "Refresh Logs"
msgstr "Odświeżanie dzienników"

#: includes/class-cpiu-admin-interface.php:731
msgid "CDN Cache Management"
msgstr "Zarządzanie pamięcią podręczną CDN"

#: includes/class-cpiu-admin-interface.php:732
msgid ""
"Manage cached third-party CDN resources to improve performance and prevent "
"throttling."
msgstr ""
"Zarządzanie buforowanymi zasobami CDN innych firm w celu poprawy wydajności "
"i zapobiegania dławieniu."

#: includes/class-cpiu-admin-interface.php:915
#: includes/class-cpiu-admin-interface.php:1090
#: includes/class-cpiu-admin-interface.php:1276
msgid "Status"
msgstr "Status"

#: includes/class-cpiu-admin-interface.php:745
msgid "Version:"
msgstr "Wersja:"

#: includes/class-cpiu-admin-interface.php:749
msgid "JavaScript:"
msgstr "JavaScript:"

#: includes/class-cpiu-admin-interface.php:751
msgid "Cached"
msgstr "W pamięci podręcznej"

#: includes/class-cpiu-admin-interface.php:753
msgid "Cached on %s"
msgstr "Buforowane na %s"

#: includes/class-cpiu-admin-interface.php:756
msgid "Not cached"
msgstr "Nie buforowane"

#: includes/class-cpiu-admin-interface.php:761
msgid "CSS:"
msgstr "CSS:"

#: includes/class-cpiu-admin-interface.php:779
msgid "Refresh All Cache"
msgstr "Odśwież całą pamięć podręczną"

#: includes/class-cpiu-admin-interface.php:783
msgid "Clear All Cache"
msgstr "Wyczyść całą pamięć podręczną"

#: includes/class-cpiu-admin-interface.php:788
msgid "About CDN Caching"
msgstr "Informacje o buforowaniu CDN"

#: includes/class-cpiu-admin-interface.php:790
msgid ""
"External CDN resources are automatically cached locally to improve "
"performance"
msgstr ""
"Zewnętrzne zasoby CDN są automatycznie buforowane lokalnie w celu poprawy "
"wydajności"

#: includes/class-cpiu-admin-interface.php:791
msgid "Cache is automatically refreshed every 24 hours"
msgstr "Pamięć podręczna jest automatycznie odświeżana co 24 godziny"

#: includes/class-cpiu-admin-interface.php:792
msgid "Cached files are stored in your WordPress uploads directory"
msgstr ""
"Pliki w pamięci podręcznej są przechowywane w katalogu uploads WordPress"

#: includes/class-cpiu-admin-interface.php:793
msgid "This prevents throttling from external CDN services"
msgstr "Zapobiega to ograniczaniu przepustowości przez zewnętrzne usługi CDN"

#: includes/class-cpiu-admin-interface.php:802
msgid "Uninstall Preferences"
msgstr "Odinstaluj preferencje"

#: includes/class-cpiu-admin-interface.php:803
msgid "Configure what happens to your data when the plugin is uninstalled."
msgstr ""
"Skonfiguruj, co stanie się z Twoimi danymi, gdy wtyczka zostanie "
"odinstalowana."

#: includes/class-cpiu-admin-interface.php:820
msgid "Important: Data Protection Notice"
msgstr "Ważne: Informacja o ochronie danych"

#: includes/class-cpiu-admin-interface.php:822
msgid ""
"This plugin follows WordPress and Envato marketplace standards for data "
"handling:"
msgstr ""
"Ta wtyczka jest zgodna ze standardami WordPress i Envato marketplace w "
"zakresie obsługi danych:"

#: includes/class-cpiu-admin-interface.php:824
msgid "Deactivation:"
msgstr "Dezaktywacja:"

#: includes/class-cpiu-admin-interface.php:824
msgid ""
"No data is deleted when you deactivate the plugin. All settings and uploaded "
"images are preserved."
msgstr ""
"Po dezaktywacji wtyczki żadne dane nie są usuwane. Wszystkie ustawienia i "
"przesłane obrazy zostają zachowane."

#: includes/class-cpiu-admin-interface.php:825
msgid "Uninstallation:"
msgstr "Dezinstalacja:"

#: includes/class-cpiu-admin-interface.php:825
msgid ""
"You can choose whether to keep or delete your data during uninstallation."
msgstr ""
"Podczas odinstalowywania można wybrać, czy dane mają zostać zachowane, czy "
"usunięte."

#: includes/class-cpiu-admin-interface.php:830
msgid "Uninstall Data Preference"
msgstr "Odinstaluj preferencje dotyczące danych"

#: includes/class-cpiu-admin-interface.php:831
msgid ""
"Choose what should happen to your plugin data when you uninstall the plugin:"
msgstr "Wybierz, co ma się stać z danymi wtyczki po jej odinstalowaniu:"

#: includes/class-cpiu-admin-interface.php:836
msgid "Keep all data (Recommended)"
msgstr "Zachowaj wszystkie dane (zalecane)"

#: includes/class-cpiu-admin-interface.php:838
msgid ""
"Preserve all settings, configurations, and uploaded images. You can "
"reinstall the plugin later without losing any data."
msgstr ""
"Zachowuje wszystkie ustawienia, konfiguracje i przesłane obrazy. Możesz "
"ponownie zainstalować wtyczkę później bez utraty danych."

#: includes/class-cpiu-admin-interface.php:844
msgid "Delete all data"
msgstr "Usuń wszystkie dane"

#: includes/class-cpiu-admin-interface.php:846
msgid ""
"Remove all plugin settings and configurations. Note: Uploaded images "
"referenced in orders will be preserved for data integrity."
msgstr ""
"Usuń wszystkie ustawienia i konfiguracje wtyczki. Uwaga: Przesłane obrazy, "
"do których odwołują się zamówienia, zostaną zachowane w celu zachowania "
"integralności danych."

#: includes/class-cpiu-admin-interface.php:854
msgid "Save Preference"
msgstr "Zapisz preferencje"

#: includes/class-cpiu-admin-interface.php:860
msgid "Export Settings Before Uninstall"
msgstr "Eksport ustawień przed odinstalowaniem"

#: includes/class-cpiu-admin-interface.php:861
msgid ""
"Before uninstalling, you can export your settings to a backup file. This "
"allows you to restore your configuration if you reinstall the plugin later."
msgstr ""
"Przed odinstalowaniem można wyeksportować ustawienia do pliku kopii "
"zapasowej. Umożliwi to przywrócenie konfiguracji w przypadku późniejszej "
"ponownej instalacji wtyczki."

#: includes/class-cpiu-admin-interface.php:866
msgid "Export Settings Backup"
msgstr "Kopia zapasowa ustawień eksportu"

#: includes/class-cpiu-admin-interface.php:871
msgid "What gets exported:"
msgstr "Co jest eksportowane:"

#: includes/class-cpiu-admin-interface.php:873
msgid "All plugin settings and configurations"
msgstr "Wszystkie ustawienia i konfiguracje wtyczek"

#: includes/class-cpiu-admin-interface.php:874
msgid "Product-specific image upload configurations"
msgstr "Konfiguracje przesyłania obrazów specyficzne dla produktu"

#: includes/class-cpiu-admin-interface.php:875
msgid "Default settings and preferences"
msgstr "Ustawienia domyślne i preferencje"

#: includes/class-cpiu-admin-interface.php:876
msgid "Export timestamp and plugin version"
msgstr "Eksportuj znacznik czasu i wersję wtyczki"

#: includes/class-cpiu-admin-interface.php:878
msgid ""
"Note: Uploaded images are not included in the export. Only configuration "
"settings are backed up."
msgstr ""
"Uwaga: Przesłane obrazy nie są uwzględniane w eksporcie. Kopia zapasowa "
"obejmuje tylko ustawienia konfiguracji."

